<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ cloud backup and device-to-device transfer. Empty rules keep the default: all app
   data (the database and settings) is included, so moving to a new phone keeps the user's
   training. The app's own JSON backups remain the portable, user-controlled copy.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
