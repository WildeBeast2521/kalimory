<?xml version="1.0" encoding="utf-8"?>
<!-- The built-in exercise catalogue in Simplified Chinese. The English source is res/values/catalogue_strings.xml. -->
<resources>
    <string name="cat_chain_push">俯卧撑</string>
    <string name="cat_push_wall">靠墙俯卧撑</string>
    <string name="cat_push_wall_desc">身体保持笔直，推离墙面。学习俯卧撑姿势最简单的方法。</string>
    <string name="cat_push_wall_cues">双手与胸同高，略宽于肩\n从头到脚跟保持一条直线\n胸部贴近墙面，再推开</string>
    <string name="cat_push_incline">上斜俯卧撑</string>
    <string name="cat_push_incline_desc">双手撑在长凳、桌子或台阶上的俯卧撑。支撑越高越容易。</string>
    <string name="cat_push_incline_cues">双手放在边缘，位于肩膀正下方\n收紧臀部，保持髋部水平\n下降至胸部碰到边缘</string>
    <string name="cat_push_knee">跪姿俯卧撑</string>
    <string name="cat_push_knee_desc">以膝盖着地的俯卧撑，从膝盖到头保持一条直线。</string>
    <string name="cat_push_knee_cues">膝盖放在柔软的地方，髋部前送\n肘部与身体约成45度\n下降的是胸部，不是髋部</string>
    <string name="cat_push_full">俯卧撑</string>
    <string name="cat_push_full_desc">标准俯卧撑：双手和脚尖着地，身体笔直，胸部下降到离地一拳高。</string>
    <string name="cat_push_full_cues">双手在肩膀正下方，手指张开\n收紧腹部，保持背部平直\n肘部向后约45度，不要向外张开</string>
    <string name="cat_push_diamond">钻石俯卧撑</string>
    <string name="cat_push_diamond_desc">双手在胸下靠拢的俯卧撑，把更多负荷转到肱三头肌。</string>
    <string name="cat_push_diamond_cues">拇指和食指在胸下相碰\n肘部贴近身体\n下降至胸部碰到双手</string>
    <string name="cat_push_decline">下斜俯卧撑</string>
    <string name="cat_push_decline_desc">双脚放在长凳或台阶上的俯卧撑，让手臂承担更多体重。</string>
    <string name="cat_push_decline_cues">双脚在凳上，双手在地上\n髋部保持一线，不要翘起\n额头向双手之间的地面下降</string>
    <string name="cat_push_archer">弓箭手俯卧撑</string>
    <string name="cat_push_archer_desc">宽距俯卧撑，一侧手臂承担大部分负荷，另一侧手臂伸直放在旁边。</string>
    <string name="cat_push_archer_cues">双手约为两倍肩宽\n一侧手臂弯曲，另一侧保持伸直\n胸部移到发力手的上方</string>
    <string name="cat_push_one_arm">单臂俯卧撑</string>
    <string name="cat_push_one_arm_desc">用一只手完成的俯卧撑，双脚分开以保持平衡。俯卧撑进阶的长期目标。</string>
    <string name="cat_push_one_arm_cues">双脚分开，空闲的手放在背后\n发力手在胸下，略向内\n双肩与地面平行</string>
    <string name="cat_chain_vpush">倒立俯卧撑</string>
    <string name="cat_vpush_pike">屈体俯卧撑</string>
    <string name="cat_vpush_pike_desc">髋部抬高的俯卧撑，身体呈倒V形，由肩部发力推起。</string>
    <string name="cat_vpush_pike_cues">双脚向手走近，直到髋部抬高\n头顶向双手之间下降\n用肩部推回</string>
    <string name="cat_vpush_elevated_pike">脚抬高屈体俯卧撑</string>
    <string name="cat_vpush_elevated_pike_desc">双脚放在长凳上的屈体俯卧撑，更接近倒立，对肩部要求更高。</string>
    <string name="cat_vpush_elevated_pike_cues">双脚在凳上，髋部在双手正上方\n头部落在双手前方，形成三角形\n肘部在手腕正上方</string>
    <string name="cat_vpush_wall_hold">靠墙倒立</string>
    <string name="cat_vpush_wall_hold_desc">胸部朝墙保持倒立，增强倒立的力量和适应感。</string>
    <string name="cat_vpush_wall_hold_cues">双手靠近墙的同时，双脚沿墙向上走\n用力推地，手臂伸直\n肋骨内收，身体成一直线</string>
    <string name="cat_vpush_wall_negative">靠墙倒立俯卧撑离心</string>
    <string name="cat_vpush_wall_negative_desc">从靠墙倒立缓慢下降到头部着地，然后下来重新开始。</string>
    <string name="cat_vpush_wall_negative_cues">用三到五秒下降\n头部落在双手前方\n开始时在头下垫一个软垫</string>
    <string name="cat_vpush_wall_hspu">靠墙倒立俯卧撑</string>
    <string name="cat_vpush_wall_hspu_desc">靠墙倒立完成的完整俯卧撑，下降到头部再推起。</string>
    <string name="cat_vpush_wall_hspu_cues">双手与肩同宽，距墙一掌长\n有控制地下降到软垫上\n笔直推起并锁定手臂</string>
    <string name="cat_chain_dip">臂屈伸</string>
    <string name="cat_dip_bench">凳上臂屈伸</string>
    <string name="cat_dip_bench_desc">双手撑在身后的长凳上、双脚着地完成的臂屈伸。</string>
    <string name="cat_dip_bench_cues">双手在边缘，手指朝前\n背部贴近长凳\n下降到上臂水平即可，不要更低</string>
    <string name="cat_dip_support">双杠支撑</string>
    <string name="cat_dip_support_desc">在双杠上用伸直的手臂撑起身体，即臂屈伸的顶端姿势。</string>
    <string name="cat_dip_support_cues">手臂伸直锁定\n肩膀下沉，远离耳朵\n双腿并拢，稍向前</string>
    <string name="cat_dip_negative">臂屈伸离心</string>
    <string name="cat_dip_negative_desc">从支撑位缓慢下降到臂屈伸的底部。</string>
    <string name="cat_dip_negative_cues">用三到五秒下降\n身体稍微前倾\n肩膀略低于肘部时停止</string>
    <string name="cat_dip_full">臂屈伸</string>
    <string name="cat_dip_full_desc">在双杠上下降再推起。</string>
    <string name="cat_dip_full_cues">从直臂支撑开始\n下降到肩膀略低于肘部\n推起至手臂伸直</string>
    <string name="cat_chain_pull">引体向上</string>
    <string name="cat_pull_dead_hang">直臂悬垂</string>
    <string name="cat_pull_dead_hang_desc">伸直手臂悬挂在杆上，增强拉的动作所需的握力和肩部力量。</string>
    <string name="cat_pull_dead_hang_cues">握距略宽于肩\n双腿放松，身体静止\n平稳呼吸</string>
    <string name="cat_pull_scapular">肩胛引体</string>
    <string name="cat_pull_scapular_desc">在悬垂中，不弯曲手臂，把肩胛骨向下、向后拉。</string>
    <string name="cat_pull_scapular_cues">手臂保持伸直\n通过沉肩让胸部稍微抬起\n有控制地回到悬垂</string>
    <string name="cat_pull_negative">引体向上离心</string>
    <string name="cat_pull_negative_desc">从下巴过杆的位置开始，缓慢下降到悬垂。</string>
    <string name="cat_pull_negative_cues">跳起或踩上到顶端\n用三到五秒下降\n以完全悬垂结束</string>
    <string name="cat_pull_band">弹力带辅助引体向上</string>
    <string name="cat_pull_band_desc">在膝盖或脚下套一根弹力带，分担一部分体重的引体向上。</string>
    <string name="cat_pull_band_cues">把弹力带挂在杆上，再踩进去\n拉到下巴超过杆\n变强后换更轻的弹力带</string>
    <string name="cat_pull_chin">反握引体向上</string>
    <string name="cat_pull_chin_desc">掌心朝向自己的引体向上，肱二头肌参与更多。</string>
    <string name="cat_pull_chin_cues">双手与肩同宽，掌心朝向自己\n把肘部向下拉到身体两侧\n下巴过杆，然后完全下放</string>
    <string name="cat_pull_full">引体向上</string>
    <string name="cat_pull_full_desc">掌心朝外，从悬垂把身体拉起，直到下巴超过杆。</string>
    <string name="cat_pull_full_cues">握距略宽于肩\n每次都从完全悬垂开始\n用胸部带动，而不是下巴</string>
    <string name="cat_pull_archer">弓箭手引体向上</string>
    <string name="cat_pull_archer_desc">宽握向一侧手拉起，另一侧手臂几乎保持伸直。</string>
    <string name="cat_pull_archer_cues">宽握\n向一侧手拉，另一侧手臂伸直滑动\n每组或每次交替两侧</string>
    <string name="cat_pull_one_arm_negative">单臂引体向上离心</string>
    <string name="cat_pull_one_arm_negative_desc">从引体向上的顶端，用一只手臂缓慢下降。</string>
    <string name="cat_pull_one_arm_negative_cues">双手在顶端开始，然后松开一只手\n尽可能慢地下降\n保持肩膀下沉</string>
    <string name="cat_pull_one_arm">单臂引体向上</string>
    <string name="cat_pull_one_arm_desc">用一只手臂完成的完整引体向上。引体向上进阶的长期目标。</string>
    <string name="cat_pull_one_arm_cues">从静止悬垂开始\n身体稍微转向发力手臂\n把肘部向下拉到体侧</string>
    <string name="cat_chain_row">划船</string>
    <string name="cat_row_incline">斜身划船</string>
    <string name="cat_row_incline_desc">身体向后倾斜，把胸部拉向高杆或结实的桌边。</string>
    <string name="cat_row_incline_cues">站得越直越容易\n从头到脚跟保持笔直\n把胸部拉向杆</string>
    <string name="cat_row_horizontal">水平划船</string>
    <string name="cat_row_horizontal_desc">悬挂在齐腰高的杆下，身体笔直、脚跟着地，把胸部拉到杆上。</string>
    <string name="cat_row_horizontal_cues">杆大约与髋同高\n顶端收紧肩胛骨\n下降至手臂伸直</string>
    <string name="cat_row_feet_elevated">脚抬高划船</string>
    <string name="cat_row_feet_elevated_desc">双脚放在长凳上的水平划船，身体水平，需要拉起更多体重。</string>
    <string name="cat_row_feet_elevated_cues">双脚在凳上，身体水平\n保持髋部抬起\n把胸部一直拉到杆上</string>
    <string name="cat_row_archer">弓箭手划船</string>
    <string name="cat_row_archer_desc">宽握向一侧手拉起，另一侧手臂保持伸直的划船。</string>
    <string name="cat_row_archer_cues">宽握\n向一侧手拉，另一侧手臂保持伸直\n不让身体扭转</string>
    <string name="cat_row_one_arm">单臂划船</string>
    <string name="cat_row_one_arm_desc">用一只手臂完成的水平划船，双脚分开防止身体转动。</string>
    <string name="cat_row_one_arm_cues">双脚分开保持平衡\n发力手与胸部对齐\n拉的时候抵抗扭转</string>
    <string name="cat_chain_squat">深蹲</string>
    <string name="cat_squat_assisted">辅助深蹲</string>
    <string name="cat_squat_assisted_desc">扶着门框或结实的支撑物深蹲，手臂只在需要时借力。</string>
    <string name="cat_squat_assisted_cues">双脚与肩同宽，脚尖稍向外\n像坐椅子一样向后向下坐\n全脚掌发力站起</string>
    <string name="cat_squat_full">徒手深蹲</string>
    <string name="cat_squat_full_desc">不借助支撑的完整深蹲，髋部至少下降到与膝同高。</string>
    <string name="cat_squat_full_cues">双脚与肩同宽，脚尖稍向外\n膝盖朝脚尖方向移动\n挺胸，脚跟着地</string>
    <string name="cat_squat_split">分腿蹲</string>
    <string name="cat_squat_split_desc">从大步前后站姿，把后侧膝盖向地面下降，再站起。</string>
    <string name="cat_squat_split_cues">双脚前后相距一大步\n垂直向下，不要向前\n前侧膝盖跟随脚尖方向</string>
    <string name="cat_squat_bulgarian">保加利亚分腿蹲</string>
    <string name="cat_squat_bulgarian_desc">后脚放在长凳上的分腿蹲，让前腿承担更多负荷。</string>
    <string name="cat_squat_bulgarian_cues">后脚脚背放在凳上\n前脚足够靠前，让膝盖保持在脚上方\n下降至后侧膝盖几乎碰到地面</string>
    <string name="cat_squat_assisted_pistol">辅助手枪蹲</string>
    <string name="cat_squat_assisted_pistol_desc">扶着支撑物的单腿深蹲，另一条腿向前伸直。</string>
    <string name="cat_squat_assisted_pistol_cues">扶住门框或立柱\n空闲的腿向前伸直\n在支撑腿上缓慢下降</string>
    <string name="cat_squat_shrimp">虾式蹲</string>
    <string name="cat_squat_shrimp_desc">单腿深蹲，在身后抓住另一只脚，把后侧膝盖降到地面。</string>
    <string name="cat_squat_shrimp_cues">用同侧的手抓住后脚\n身体稍微前倾以保持平衡\n膝盖轻轻着地</string>
    <string name="cat_squat_pistol">手枪蹲</string>
    <string name="cat_squat_pistol_desc">完整的单腿深蹲，另一条腿向前伸直。深蹲进阶的目标。</string>
    <string name="cat_squat_pistol_cues">手臂前伸保持平衡\n脚跟全程着地\n蹲到底，再发力站起</string>
    <string name="cat_chain_hinge">髋铰链</string>
    <string name="cat_hinge_bridge">臀桥</string>
    <string name="cat_hinge_bridge_desc">仰卧屈膝，抬起髋部，直到从膝盖到肩膀成一直线。</string>
    <string name="cat_hinge_bridge_cues">双脚平放，靠近髋部\n用脚跟发力\n顶端收紧臀部，肋骨下沉</string>
    <string name="cat_hinge_single_bridge">单腿臀桥</string>
    <string name="cat_hinge_single_bridge_desc">用一条腿完成的臀桥，另一条腿伸直或弯曲抬起。</string>
    <string name="cat_hinge_single_bridge_cues">发力脚靠近髋部\n抬起时保持髋部水平\n在顶端停顿一秒</string>
    <string name="cat_hinge_hip_thrust">单腿臀推</string>
    <string name="cat_hinge_hip_thrust_desc">肩部靠在长凳上的单腿臀桥，动作幅度更大。</string>
    <string name="cat_hinge_hip_thrust_cues">肩胛骨靠在凳子边缘\n收下巴，目视前方\n推起至身体水平</string>
    <string name="cat_hinge_slider_curl">滑动腿弯举</string>
    <string name="cat_hinge_slider_curl_desc">在臀桥姿势下，脚跟踩在毛巾或滑盘上，把脚跟拉回再推出去。</string>
    <string name="cat_hinge_slider_curl_cues">全程保持臀桥\n把脚跟拉向自己\n慢慢滑出去</string>
    <string name="cat_hinge_nordic_negative">北欧挺离心</string>
    <string name="cat_hinge_nordic_negative_desc">跪姿，脚踝固定，尽可能慢地把身体向前放下。</string>
    <string name="cat_hinge_nordic_negative_cues">脚踝固定在结实的物体下面\n从膝盖到头保持笔直\n用手撑住，再推回起始位置</string>
    <string name="cat_hinge_nordic">北欧挺</string>
    <string name="cat_hinge_nordic_desc">从跪姿向前下降，只用腘绳肌把身体拉回。</string>
    <string name="cat_hinge_nordic_cues">脚踝固定\n髋部保持伸直，不要弯曲\n下降和起身都完全受控</string>
    <string name="cat_chain_core">核心</string>
    <string name="cat_core_dead_bug">死虫</string>
    <string name="cat_core_dead_bug_desc">仰卧，手臂和膝盖抬起，保持背部平贴，同时放下对侧的手臂和腿。</string>
    <string name="cat_core_dead_bug_cues">下背部压向地面\n动作缓慢，伸展时呼气\n两侧交替</string>
    <string name="cat_core_plank">平板支撑</string>
    <string name="cat_core_plank_desc">用前臂和脚尖支撑，保持身体笔直。</string>
    <string name="cat_core_plank_cues">肘部在肩膀正下方\n收紧臀部，绷紧腹部\n不要让髋部下塌</string>
    <string name="cat_core_hollow_tuck">团身空心支撑</string>
    <string name="cat_core_hollow_tuck_desc">仰卧，膝盖收向胸前，肩部抬起，下背部压在地面上。</string>
    <string name="cat_core_hollow_tuck_cues">下背部平贴地面\n肩部离地，下巴微收\n手臂向脚的方向伸</string>
    <string name="cat_core_hollow">空心支撑</string>
    <string name="cat_core_hollow_desc">仰卧保持浅浅的香蕉形：双腿伸直放低，手臂举过头顶，下背部贴地。</string>
    <string name="cat_core_hollow_cues">下背部始终压在地面上\n双腿并拢伸直\n如果背部抬起，就把腿抬高</string>
    <string name="cat_chain_leg_raise">举腿</string>
    <string name="cat_leg_raise_lying_knee">仰卧收膝</string>
    <string name="cat_leg_raise_lying_knee_desc">仰卧，把膝盖收向胸部，再缓慢放下。</string>
    <string name="cat_leg_raise_lying_knee_cues">双手放在髋部两侧\n顶端时让髋部稍微卷离地面\n放下时不要让背部拱起</string>
    <string name="cat_leg_raise_lying_leg">仰卧举腿</string>
    <string name="cat_leg_raise_lying_leg_desc">仰卧，把伸直的双腿举到垂直，再缓慢放下。</string>
    <string name="cat_leg_raise_lying_leg_cues">双腿并拢伸直\n下背部保持贴地\n在离地面不远处停住</string>
    <string name="cat_leg_raise_hanging_knee">悬垂收膝</string>
    <string name="cat_leg_raise_hanging_knee_desc">悬挂在杆上，不借助摆动，把膝盖抬向胸部。</string>
    <string name="cat_leg_raise_hanging_knee_cues">从静止悬垂开始\n顶端时向上卷起骨盆\n缓慢放下</string>
    <string name="cat_leg_raise_hanging_leg">悬垂举腿</string>
    <string name="cat_leg_raise_hanging_leg_desc">悬挂在杆上，把伸直的双腿举到与髋同高或更高。</string>
    <string name="cat_leg_raise_hanging_leg_cues">双腿伸直并拢\n每次之间不要摆动\n举到双腿水平</string>
    <string name="cat_leg_raise_toes_to_bar">脚尖触杠</string>
    <string name="cat_leg_raise_toes_to_bar_desc">悬挂在杆上，把伸直的双腿一直举到碰到杆。</string>
    <string name="cat_leg_raise_toes_to_bar_cues">直臂把杆稍微向下压\n抬腿并卷起髋部\n有控制地放下</string>
    <string name="cat_chain_handstand">倒立</string>
    <string name="cat_chain_l_sit">L 坐</string>
    <string name="cat_chain_muscle_up">双力臂</string>
    <string name="cat_handstand_crow">乌鸦式</string>
    <string name="cat_handstand_crow_desc">膝盖压在上臂后侧，用双手保持平衡。第一次体会把体重放在手上。</string>
    <string name="cat_handstand_crow_cues">双手平放，手指张开，与肩同宽\n膝盖高高压在上臂上\n身体前倾直到双脚离地</string>
    <string name="cat_handstand_wall_walk">靠墙爬升</string>
    <string name="cat_handstand_wall_walk_desc">从脚抵墙的俯卧撑姿势，双脚沿墙向上走、双手向墙靠近，再退回。</string>
    <string name="cat_handstand_wall_walk_cues">手脚都用小步\n手臂伸直，身体收紧\n只靠近到还能控制的位置</string>
    <string name="cat_handstand_kick_up">踢腿上倒立</string>
    <string name="cat_handstand_kick_up_desc">在空地上踢腿向倒立，短暂找到平衡点后下来。</string>
    <string name="cat_handstand_kick_up_cues">双手与肩同宽，目视两手之间\n一条腿踢起，另一条腿跟上\n过头时向侧面落地</string>
    <string name="cat_handstand_freestanding">徒手倒立</string>
    <string name="cat_handstand_freestanding_desc">不靠墙，倒立用双手保持平衡，身体成一条直线。</string>
    <string name="cat_handstand_freestanding_cues">推地，肩膀贴近耳朵\n双腿并拢，脚尖绷直\n用指尖微调</string>
    <string name="cat_l_sit_foot_supported">脚撑 L 坐</string>
    <string name="cat_l_sit_foot_supported_desc">坐姿，双手放在髋旁，向下压使髋部抬起，脚跟留在地上。</string>
    <string name="cat_l_sit_foot_supported_cues">双手平放在髋旁\n向下压并抬起髋部\n沉肩，远离耳朵</string>
    <string name="cat_l_sit_tuck">团身 L 坐</string>
    <string name="cat_l_sit_tuck_desc">直臂撑起身体，膝盖收向胸口。</string>
    <string name="cat_l_sit_tuck_cues">手臂伸直锁定\n膝盖紧贴胸口\n向下推地面或把手</string>
    <string name="cat_l_sit_one_leg">单腿 L 坐</string>
    <string name="cat_l_sit_one_leg_desc">团身 L 坐时一条腿向前伸直，每组换腿。</string>
    <string name="cat_l_sit_one_leg_cues">一侧膝盖收起，另一条腿伸直\n把伸直的腿抬到与髋同高\n每组换腿</string>
    <string name="cat_l_sit_full">L 坐</string>
    <string name="cat_l_sit_full_desc">直臂撑起身体，双腿向前伸直，形成 L 形。</string>
    <string name="cat_l_sit_full_cues">双腿并拢伸直，与髋同高\n脚尖绷直\n双手持续向下推</string>
    <string name="cat_l_sit_v_sit">V 坐</string>
    <string name="cat_l_sit_v_sit_desc">从 L 坐把伸直的双腿抬得更高，直到身体呈 V 形。</string>
    <string name="cat_l_sit_v_sit_cues">肩膀稍向后倾\n双腿尽量抬高\n手臂保持伸直</string>
    <string name="cat_muscle_up_high_pull">胸触杠引体向上</string>
    <string name="cat_muscle_up_high_pull_desc">发力足够大、让胸口触到杠的引体向上：双力臂需要的拉力。</string>
    <string name="cat_muscle_up_high_pull_cues">每次都从完全悬垂开始\n快速拉起，肘部向下发力\n用胸口触杠</string>
    <string name="cat_muscle_up_negative">双力臂离心</string>
    <string name="cat_muscle_up_negative_desc">从杠上直臂位置开始，缓慢经过臂屈伸和翻转下降到悬垂。</string>
    <string name="cat_muscle_up_negative_cues">从杠上直臂开始\n缓慢下降经过臂屈伸\n翻转时让杠贴近身体</string>
    <string name="cat_muscle_up_band">弹力带辅助双力臂</string>
    <string name="cat_muscle_up_band_desc">完整的双力臂，弹力带在拉起和翻转时分担部分体重。</string>
    <string name="cat_muscle_up_band_cues">高拉，拉向胸口\n迅速把胸口翻到杠上方\n推起至手臂伸直</string>
    <string name="cat_muscle_up_full">双力臂</string>
    <string name="cat_muscle_up_full_desc">从悬垂一气呵成地把身体拉起并翻到杠上，最后在杠上直臂撑住。</string>
    <string name="cat_muscle_up_full_cues">爆发式拉起，把杠拉向胸口\n转动手腕，翻到杠上\n推至手臂伸直</string>
    <string name="cat_chain_front_lever">前水平</string>
    <string name="cat_chain_back_lever">后水平</string>
    <string name="cat_chain_planche">俄挺</string>
    <string name="cat_front_lever_tuck">团身前水平</string>
    <string name="cat_front_lever_tuck_desc">直臂悬挂在杆上，膝盖收向胸口，身体保持水平。</string>
    <string name="cat_front_lever_tuck_cues">手臂伸直，把杆向髋部压\n背部平直并保持水平\n膝盖紧贴胸口</string>
    <string name="cat_front_lever_adv_tuck">高级团身前水平</string>
    <string name="cat_front_lever_adv_tuck_desc">背部平直、髋部打开、膝盖成直角的团身前水平。</string>
    <string name="cat_front_lever_adv_tuck_cues">把背部压平\n把膝盖推远，直到大腿水平\n持续向下压杆</string>
    <string name="cat_front_lever_one_leg">单腿前水平</string>
    <string name="cat_front_lever_one_leg_desc">一条腿伸直、另一条腿团起的前水平，每组换腿。</string>
    <string name="cat_front_lever_one_leg_cues">一条腿伸直，与身体成一线\n另一侧膝盖团起\n每组换腿</string>
    <string name="cat_front_lever_straddle">分腿前水平</string>
    <string name="cat_front_lever_straddle_desc">双腿伸直并大幅分开的前水平，可以缩短力臂。</string>
    <string name="cat_front_lever_straddle_cues">双腿伸直并大幅分开\n髋部与肩同高\n收紧臀部</string>
    <string name="cat_front_lever_full">前水平</string>
    <string name="cat_front_lever_full_desc">面朝上直臂悬挂，全身伸直并保持水平。</string>
    <string name="cat_front_lever_full_cues">双腿并拢，身体成一直线\n直臂把杆向下压\n保持髋部不下沉</string>
    <string name="cat_back_lever_skin_the_cat">翻转（剥猫）</string>
    <string name="cat_back_lever_skin_the_cat_desc">从悬垂把双腿从两臂之间穿过并向后翻转，直到悬挂在杆后方，再翻回。</string>
    <string name="cat_back_lever_skin_the_cat_cues">收膝并从两臂之间穿过\n缓慢下降到身后的拉伸位\n按原路返回</string>
    <string name="cat_back_lever_german_hang">德式悬垂</string>
    <string name="cat_back_lever_german_hang_desc">在翻转的最低点悬挂在杆上，手臂在身后，让肩部打开。</string>
    <string name="cat_back_lever_german_hang_cues">缓慢进入拉伸\n手臂保持伸直\n按进入的路线退出</string>
    <string name="cat_back_lever_tuck">团身后水平</string>
    <string name="cat_back_lever_tuck_desc">面朝下在杆后直臂悬挂，背部水平，膝盖收向胸口。</string>
    <string name="cat_back_lever_tuck_cues">手臂伸直，杆在髋部后方\n背部保持水平\n膝盖紧贴胸口</string>
    <string name="cat_back_lever_adv_tuck">高级团身后水平</string>
    <string name="cat_back_lever_adv_tuck_desc">背部平直、髋部打开、膝盖成直角的团身后水平。</string>
    <string name="cat_back_lever_adv_tuck_cues">把背部压平\n把膝盖推远，直到大腿水平\n手臂保持伸直</string>
    <string name="cat_back_lever_straddle">分腿后水平</string>
    <string name="cat_back_lever_straddle_desc">双腿伸直并大幅分开的后水平。</string>
    <string name="cat_back_lever_straddle_cues">双腿伸直并大幅分开\n身体水平，面朝下\n收紧臀部</string>
    <string name="cat_back_lever_full">后水平</string>
    <string name="cat_back_lever_full_desc">面朝下在杆后悬挂，全身伸直并保持水平。</string>
    <string name="cat_back_lever_full_cues">双腿并拢，身体成一直线\n手臂伸直，杆在髋部位置\n不要让髋部下沉</string>
    <string name="cat_planche_lean">俄挺前倾</string>
    <string name="cat_planche_lean_desc">从俯卧撑顶端，把肩膀前倾到双手前方并保持。</string>
    <string name="cat_planche_lean_cues">手指稍向外转\n直臂向前倾\n上背部略微拱起</string>
    <string name="cat_planche_tuck">团身俄挺</string>
    <string name="cat_planche_tuck_desc">直臂撑起，双脚离地，膝盖收在身体下方保持平衡。</string>
    <string name="cat_planche_tuck_cues">手臂伸直锁定\n前倾直到双脚离地\n膝盖团起，髋部抬高</string>
    <string name="cat_planche_adv_tuck">高级团身俄挺</string>
    <string name="cat_planche_adv_tuck_desc">背部平直、髋部与肩同高的团身俄挺。</string>
    <string name="cat_planche_adv_tuck_cues">把背部压平\n髋部与肩同高\n用力推地</string>
    <string name="cat_planche_straddle">分腿俄挺</string>
    <string name="cat_planche_straddle_desc">直臂撑起，身体水平，双腿伸直并大幅分开保持平衡。</string>
    <string name="cat_planche_straddle_cues">双腿伸直并大幅分开\n身体保持水平\n前倾直到在双手上方保持平衡</string>
    <string name="cat_planche_full">俄挺</string>
    <string name="cat_planche_full_desc">直臂撑起，全身伸直并在地面上方保持水平。</string>
    <string name="cat_planche_full_cues">双腿并拢，身体成一直线\n手臂伸直，肩膀在双手前方\n全身收紧</string>
</resources>
